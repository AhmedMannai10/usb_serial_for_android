<?xml version="1.0" encoding="utf-8"?>
<!-- USB devices that trigger the USB_DEVICE_ATTACHED intent-filter in
     AndroidManifest.xml. Vendor IDs are written in decimal. Hex works only
     with a 0x prefix ("0x2341"); a bare "2341" is read as decimal. -->
<resources>
    <!-- Arduino (0x2341): Uno, Mega, Leonardo, ... -->
    <usb-device vendor-id="9025" />
    <!-- QinHeng CH340/CH341 (0x1A86): many Nano clones and ESP32/ESP8266 boards -->
    <usb-device vendor-id="6790" />
    <!-- Silicon Labs CP210x (0x10C4): many ESP32 dev boards -->
    <usb-device vendor-id="4292" />
    <!-- FTDI (0x0403): FT232 adapters -->
    <usb-device vendor-id="1027" />
    <!-- Prolific PL2303 (0x067B) -->
    <usb-device vendor-id="1659" />
    <!-- Espressif native USB (0x303A): ESP32-S2/S3/C3 -->
    <usb-device vendor-id="12346" />
    <!-- Raspberry Pi RP2040 (0x2E8A): Pico -->
    <usb-device vendor-id="11914" />
</resources>
